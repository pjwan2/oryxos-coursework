# Template of the environment variables OryxOS reads. Copy to an UNTRACKED file (for example .env.local)
# and load it in your shell; never put real values in this file. Empty means "not set".
# Defaults are in oryxos-boot/src/main/resources/application.yaml.

# Web server (always bound to 127.0.0.1; the console and API have no authentication)
SERVER_PORT=8080

# SQLite database file (relative paths are resolved against the working directory).
# Use a Windows-style path (C:/...) on Windows, not /c/...
ORYXOS_JDBC_URL=jdbc:sqlite:./oryxos-dev.db

# Directory of agent definitions (YAML)
ORYXOS_PROFILE_DIR=.oryxos/profiles

# Long-term memory backend: markdown | sqlite | mem0
ORYXOS_MEMORY_BACKEND=markdown
ORYXOS_MEMORY_FILE=.oryxos/memory/MEMORY.md

# Register cron triggers (false: schedules are still validated at startup)
ORYXOS_SCHEDULER_ENABLED=true

# Real model provider. Empty: only the local Mock model is available.
# This has never been exercised against the real service in this project.
DEEPSEEK_API_KEY=

# Mem0 (only with ORYXOS_MEMORY_BACKEND=mem0; also set oryxos.memory.mem0-base-url).
# Never exercised against a real Mem0 server.
MEM0_API_KEY=
